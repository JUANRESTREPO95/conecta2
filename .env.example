# Conecta2 — variables para montar varios paneles en el mismo Portainer.
#
# Copia este archivo como .env (o escribe estas variables en Portainer, en
# cada stack) y CAMBIA LOS VALORES POR EMPRESA. El .env no se sube a GitHub.
#
# Ejemplo de una empresa:
#   CONECTA2_CONTENEDOR=conecta2-megafantasy
#   CONECTA2_PUERTO=8051
#   CONECTA2_DATOS=/opt/conecta2/megafantasy
#
# Siguiente empresa: otro nombre, otro puerto (8052) y otra carpeta.

# Nombre del contenedor (único por empresa)
CONECTA2_CONTENEDOR=conecta2

# Puerto del servidor que se publica (interno siempre es 8050)
CONECTA2_PUERTO=8050

# Carpeta del servidor con la BD, logos y llave (ruta ABSOLUTA, única)
CONECTA2_DATOS=/opt/conecta2/datos

# Imagen compartida por todos los paneles (la misma para todas las empresas)
CONECTA2_IMAGEN=conecta2:latest

# Zona horaria
CONECTA2_TZ=America/Bogota
